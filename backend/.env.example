# VetPet Clinic Demo - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

#----------------------------------------------------------------
# JWT Keys Configuration
#----------------------------------------------------------------
# Path to RSA public key file
# Generate with: openssl rsa -pubout -outform pem -in private_key.pem -out public_key.pem
JWT_PUBLIC_KEY_PATH=/path/to/public_key.pem

# Path to RSA private key file
# Generate with: openssl genpkey -out private_key.pem -algorithm RSA -pkeyopt rsa_keygen_bits:4096
JWT_PRIVATE_KEY_PATH=/path/to/private_key.pem

#----------------------------------------------------------------
# CORS Configuration
#----------------------------------------------------------------
# Comma-separated list of allowed origins
# Development example:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:9977

# Production example:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

#----------------------------------------------------------------
# Spring Profile
#----------------------------------------------------------------
# Use 'dev' for development, 'prod' for production
SPRING_PROFILES_ACTIVE=dev

#----------------------------------------------------------------
# Database Configuration (if not using docker-compose)
#----------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/petclinic
# SPRING_DATASOURCE_USERNAME=petclinic
# SPRING_DATASOURCE_PASSWORD=petclinic
